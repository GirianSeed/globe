* -text

# C/C++
*.c             linguist-language=C
*.h             linguist-language=C

# assembler-with-cpp
*.S             linguist-language=Assembly
*.sx            linguist-language=Assembly

# dvp-gas assembly
*.dsm           linguist-language=Assembly
*.vsm           linguist-language=Assembly
*.vcl           linguist-language=Assembly

# Makefile
*.mkf           linguist-language=Makefile
Makefile.*      linguist-language=Makefile
MakeDefs        linguist-language=Makefile
MakeRules       linguist-language=Makefile
PathDefs        linguist-language=Makefile

# Scripts
*.sh            text eol=lf
*.bash          text eol=lf
*.fish          text eol=lf
*.csh           text eol=lf
*.tcsh          text eol=lf
*.ksh           text eol=lf
*.zsh           text eol=lf

*.bat           text eol=crlf
*.cmd           text eol=crlf
*.ps1           text eol=crlf

# Visual Studio Code
# Fix syntax highlighting on GitHub to allow comments
.vscode/*.json  linguist-language=JSON-with-Comments

# archives
*.lzh           binary
*.rpm           binary
*.sit           binary
*.tar           binary
*.tar.gz        binary
*.tgz           binary
*.zip           binary

# image data
*.gf            binary
*.ipu           binary
*.m2v           binary
*.pss           binary

# sound data
*.bd            binary
*.hd            binary
*.inb           binary
*.int           binary
*.raw           binary
*.seq           binary
*.sq            binary
*.ssb           binary
*.vag           binary
*.vb            binary
*.vh            binary
*.wav           binary
